{
  "manifest_version": 3,
  "name": "Hyprash browser control",
  "version": "0.1.0",
  "description": "Local voice control of your existing tabs. No cloud service.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Hyprash browser connection"
  }
}
